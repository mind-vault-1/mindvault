{
  "name": "@mindvault/mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for MindVault — AI agent access to the vault",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distributed-nerd/mindvault.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stellar",
    "soroban",
    "x402",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mindvault-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "prepublish:check": "tsx scripts/prepublish-check.ts"
  },
  "dependencies": {
    "@mindvault/registry-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@stellar/stellar-sdk": "^15.0.1",
    "@x402/fetch": "^2.19.0",
    "@x402/stellar": "^2.19.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
